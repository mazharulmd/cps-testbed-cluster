# CPS testbed settings, read by the systemd services (/etc/cps/cps.env).
# After changing them: sudo systemctl restart cps-api cps-nodered   (head)
#                      sudo systemctl restart cps-node               (compute node)

# head = web portal, API, HELICS brokers; node = compute node (MPI ranks, federates)
CPS_ROLE=head

# --- cluster layout (head only). Leave CPS_NODES empty on a single server.
# The dashboard's Cluster page can change these too; its settings (kept in
# /srv/cps/cluster_settings.json) take precedence until "Use the settings file" is pressed.
# MPI hosts and their slots (cores for GridPACK), e.g. node1:16,node2:16
CPS_NODES=
# host names of the nodes that run the NS-3 and control-center federates (default: the head)
CPS_PLACE_NS3=
CPS_PLACE_CC=
CPS_PLACE_GRID=
# default GridPACK MPI ranks per experiment, and experiments that may run at the same time
CPS_MPI_NP=1
CPS_MAX_JOBS=1

# --- logins (strongly recommended before opening the ports to anyone)
# experiment API (port 8080): user and password
CPS_WEB_USER=admin
CPS_WEB_PASSWORD=
# Node-RED (port 1880): bcrypt hash of the password. Set both with: sudo cps-passwd
NODERED_ADMIN_USER=admin
NODERED_ADMIN_HASH=

# --- paths (the shared directory must be the same NFS mount on every node of a cluster)
CPS_SHARED=/srv/cps
CPS_RESULTS=/srv/cps/runs
CPS_GRIDS=/srv/cps/grids
CPS_CLUSTER_CONFIG=/srv/cps/cluster.json
CPS_PF_SERVER=/opt/cps/gridpack/bin/pf_server
CPS_NS3_BIN=/opt/cps/ns-3/helicstest
CPS_HELICS_BROKER=/opt/cps/helics/bin/helics_broker

# --- MPI between nodes: restrict to the cluster network interface if a node has several
# OMPI_MCA_btl_tcp_if_include=eno1
# OMPI_MCA_oob_tcp_if_include=eno1
